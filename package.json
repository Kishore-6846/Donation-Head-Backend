{
  "name": "donation-receipt-backend",
  "version": "1.0.0",
  "description": "Backend API for Donation Receipt Trust Admin Module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --config nodemon.json server.js"
  },
  "keywords": [
    "donation",
    "receipt",
    "ngo",
    "trust",
    "80g",
    "10bd"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "routes",
      "models",
      "services",
      "config",
      "controllers",
      "middleware"
    ],
    "ignore": [
      "data/**",
      "data/*",
      "data",
      "scripts/**",
      "scratch/**",
      "**/*.json"
    ],
    "ext": "js"
  }
}
